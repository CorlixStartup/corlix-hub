list emitir-comunicado (
    name: Emitir Comunicado

    entry step-1 (
        label: Step 1
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 17
            }
        }
    )

    entry step-2 (
        label: Step 2
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 18
            }
        }
    )

    entry step-3 (
        label: Step 3
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 19
            }
        }
    )

)

list navigation-menu (
