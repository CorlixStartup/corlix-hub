appProcess app-user-cargo (
    name: APP_USER_CARGO
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            BEGIN
              SELECT G.nome
                INTO :APP_USER_CARGO
                FROM COLABORADOR C
                JOIN CARGO G ON G.id_cargo = C.id_cargo
               WHERE UPPER(TRIM(C.login_apex)) = UPPER(TRIM(:APP_USER));
            EXCEPTION
              WHEN NO_DATA_FOUND THEN
                :APP_USER_CARGO := 'SEM VÍNCULO';
              WHEN TOO_MANY_ROWS THEN
                :APP_USER_CARGO := 'MÚLTIPLOS VÍNCULOS';
              WHEN OTHERS THEN
                :APP_USER_CARGO := 'ERRO AO CARREGAR CARGO';
            END;
            ```
    }
    execution {
        sequence: 1
    }
)

appProcess app-user-foto (
    name: APP_USER_FOTO
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            -- APP_USER_FOTO = caminho relativo a #APP_FILES# (o prefixo fica no HTML da Global Page).
            -- Sem foto, fica nulo: a <img> falha e o header mostra APP_USER_INICIAIS.
            BEGIN
              SELECT
                CASE
                  WHEN TRIM(C.foto_url) IS NULL
                       OR C.foto_url = '#APP_FILES#Fotos Colaboradores/' THEN
                    NULL
                  ELSE
                    'Fotos Colaboradores/' || C.foto_url
                END,
                UPPER(
                  SUBSTR(TRIM(NVL(C.primeiro_nome, C.nome_completo)), 1, 1) ||
                  SUBSTR(TRIM(NVL(C.ultimo_nome,
                    SUBSTR(TRIM(C.nome_completo), NULLIF(INSTR(TRIM(C.nome_completo), ' ', -1), 0) + 1))), 1, 1)
                )
                INTO :APP_USER_FOTO, :APP_USER_INICIAIS
                FROM COLABORADOR C
               WHERE UPPER(TRIM(C.login_apex)) = UPPER(TRIM(:APP_USER));
            EXCEPTION
              WHEN OTHERS THEN
                :APP_USER_FOTO := NULL;
                :APP_USER_INICIAIS := UPPER(SUBSTR(:APP_USER, 1, 1));
            END;
            ```
    }
    execution {
        sequence: 1
    }
)

appProcess g-nome-empresa (
    name: G_NOME_EMPRESA
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            BEGIN
              SELECT E.nome
                INTO :G_NOME_EMPRESA
                FROM COLABORADOR C
                JOIN EMPRESA E ON E.id_empresa = C.id_empresa
               WHERE UPPER(TRIM(C.login_apex)) = UPPER(TRIM(:APP_USER));
            EXCEPTION
              WHEN NO_DATA_FOUND THEN
                :G_NOME_EMPRESA := 'SEM VINCULO - usuario: ' || :APP_USER;
              WHEN TOO_MANY_ROWS THEN
                :G_NOME_EMPRESA := 'MULTIPLOS VINCULOS - usuario: ' || :APP_USER;
              WHEN OTHERS THEN
                :G_NOME_EMPRESA := 'ERRO: ' || SQLERRM;
            END;
            ```
    }
    execution {
        sequence: 1
    }
)

appProcess g-nome-usuario (
    name: G_NOME_USUARIO
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            begin
                select initcap(first_name || ' ' || last_name)
                into :G_NOME_USUARIO
                from apex_workspace_apex_users
                where upper(user_name) = upper(:APP_USER);
            
            exception
                when no_data_found then
                    :G_NOME_USUARIO := :APP_USER;
            end;
            ```
    }
    execution {
        sequence: 1
    }
)

appProcess set-g-id-empresa (
    name: SET_G_ID_EMPRESA
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            begin
              select id_empresa
                into :G_ID_EMPRESA
                from colaborador
               where upper(trim(login_apex)) = upper(trim(:APP_USER));
            exception
              when no_data_found or too_many_rows then
                :G_ID_EMPRESA := null;
            end;
            ```
    }
    execution {
        sequence: 1
        point: afterAuthentication
    }
)

