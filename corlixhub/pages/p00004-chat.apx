    dynamicAction abrir-fechar-departamento (
        name: Abrir/fechar departamento
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .ch-dept
        }

        action alternar-departamento (
            name: Alternar departamento
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    const cab   = this.triggeringElement;
                    const abrir = cab.getAttribute("aria-expanded") !== "true";
                    cab.setAttribute("aria-expanded", abrir);
                    
                    // contatos do grupo = irmãos até o próximo cabeçalho
                    $(cab).nextUntil(".ch-dept", ".ch-contact").toggleClass("is-visivel", abrir);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction enter-envia-mensagem (
        name: Enter envia mensagem
        execution {
            sequence: 30
        }
        when {
            event: keydown
            selectionType: jQuerySelector
            jquerySelector: #ch-texto
        }

        action enviar-com-enter (
            name: Enviar com Enter
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    const e = this.browserEvent;
                    // Shift+Enter quebra linha; isComposing evita enviar no meio de um acento
                    if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
                        e.preventDefault();
                        document.querySelector(".ch-enviar").click();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction enviar-mensagem (
        name: Enviar Mensagem
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .ch-enviar
        }

        action atualizar-conversa (
            name: Atualizar conversa
            action: refresh
            affectedElements {
                selectionType: region
                region: @msgs
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action gravar-mensagem (
            name: Gravar mensagem
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      l_eu    colaborador.id_colaborador%type;
                      l_texto varchar2(32767) := trim(:P4_MENSAGEM);
                    begin
                      if l_texto is null then
                        return;
                      end if;
                    
                      begin
                        select id_colaborador
                        into   l_eu
                        from   colaborador
                        where  upper(login_apex) = upper(:APP_USER)
                        fetch  first 1 row only;
                      exception
                        when no_data_found then
                          raise_application_error(-20001,
                            'Seu usuário não está vinculado a um colaborador.');
                      end;
                    
                      -- P4_CANAL_ID vem do navegador: só grava se eu participo do canal
                      insert into canal_mensagem (id_canal, id_colaborador, corpo)
                      select cp.id_canal, l_eu, substrb(l_texto, 1, 4000)
                      from   canal_participante cp
                      where  cp.id_canal       = to_number(:P4_CANAL_ID)
                      and    cp.id_colaborador = l_eu;
                    
                      if sql%rowcount = 0 then
                        raise_application_error(-20003,
                          'Você não participa desta conversa.');
                      end if;
                    
                      :P4_MENSAGEM := null;
                    end;
                    ```
                itemsToSubmit: [
                    P4_MENSAGEM
                    P4_CANAL_ID
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action preparar-envio (
            name: Preparar envio
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    const campo = document.getElementById("ch-texto");
                    const texto = campo.value.trim();
                    
                    // nada para enviar ou nenhuma conversa aberta: interrompe as próximas ações
                    if (!texto || !apex.item("P4_CANAL_ID").getValue()) {
                        campo.focus();
                        apex.da.cancelEvent.call(this);
                        return;
                    }
                    
                    apex.item("P4_MENSAGEM").setValue(texto);
                    chChat.irParaFim();
                    // limpa já, para um segundo clique não reenviar a mesma mensagem
                    campo.value = "";
                    campo.focus();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction selecionar-contato (
        name: Selecionar Contato
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .ch-contact
        }

        action atualizar-mensagens (
            name: Atualizar mensagens
            action: refresh
            affectedElements {
                selectionType: region
                region: @msgs
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action marcar-contato-selecionado (
            name: Marcar contato selecionado
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    const contato = this.triggeringElement;
                    apex.item("P4_CONTATO_ID").setValue(contato.dataset.id);
                    
                    document.querySelectorAll(".ch-contact.is-active")
                            .forEach(el => el.classList.remove("is-active"));
                    contato.classList.add("is-active");
                    
                    // copia avatar, presença, nome e cargo do contato para o cabeçalho
                    const head = document.querySelector(".ch-head");
                    head.querySelector(".ch-avatar").textContent = contato.querySelector(".ch-avatar").textContent;
                    head.querySelector(".ch-dot").className      = contato.querySelector(".ch-dot").className;
                    head.querySelector("b").textContent          = contato.querySelector(".ch-contact-txt b").textContent;
                    head.querySelector("small").textContent      = contato.querySelector(".ch-contact-txt small").textContent;
                    
                    document.querySelector(".ch-chat").classList.add("is-aberto");
                    
                    // rascunho não passa de uma conversa para outra
                    const campo = document.getElementById("ch-texto");
                    campo.value = "";
                    campo.focus();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action obter-canal-direto (
            name: Obter canal direto
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      l_eu      colaborador.id_colaborador%type;
                      l_empresa colaborador.id_empresa%type;
                      l_valido  number;
                    begin
                      begin
                        select id_colaborador, id_empresa
                        into   l_eu, l_empresa
                        from   colaborador
                        where  upper(login_apex) = upper(:APP_USER)
                        fetch  first 1 row only;
                      exception
                        when no_data_found then
                          raise_application_error(-20001,
                            'Seu usuário não está vinculado a um colaborador.');
                      end;
                    
                      -- P4_CONTATO_ID vem do navegador: só abre conversa com
                      -- colaborador ativo, da mesma empresa e diferente de mim
                      select count(*)
                      into   l_valido
                      from   colaborador
                      where  id_colaborador = to_number(:P4_CONTATO_ID)
                      and    id_empresa     = l_empresa
                      and    status         = true
                      and    id_colaborador != l_eu;
                    
                      if l_valido = 0 then
                        raise_application_error(-20002,
                          'Não é possível abrir conversa com este colaborador.');
                      end if;
                    
                      :P4_CANAL_ID := ch_get_canal_direto(l_eu, to_number(:P4_CONTATO_ID));
                    end;
                    ```
                itemsToSubmit: P4_CONTATO_ID
                itemsToReturn: P4_CANAL_ID
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process ch-verificar-msgs (
        name: CH_VERIFICAR_MSGS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_canal  number := to_number(apex_application.g_x01 default null on conversion error);
                  l_ultima canal_mensagem.id_canal_mensagem%type;
                  l_qtd    number;
                begin
                  -- mesma regra da região Mensagens: só canais de que o usuário logado participa.
                  -- "última" = a mais recente pela mesma ordem da região (data_envio, id).
                  select max(m.id_canal_mensagem) keep (dense_rank last order by m.data_envio, m.id_canal_mensagem),
                         count(*)
                  into   l_ultima, l_qtd
                  from   canal_mensagem m
                  where  m.id_canal = l_canal
                  and    nvl(m.excluida, false) = false
                  and    exists (
                           select 1
                           from   canal_participante cp
                           join   colaborador eu on eu.id_colaborador = cp.id_colaborador
                           where  cp.id_canal = m.id_canal
                           and    upper(eu.login_apex) = upper(:APP_USER)
                         );
                
                  -- mesmo formato que o JS monta a partir da tela: "<última>:<quantidade>".
                  -- A quantidade é limitada a 200, o Number of Rows da região.
                  apex_json.open_object;
                  apex_json.write('assinatura', nvl(l_ultima, 0) || ':' || least(l_qtd, 200));
                  apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 9292820097503236
        }
    )

)

