page 4 (
    name: Chat
    alias: CHAT
    title: Chat
    appearance {
        pageTemplate: @corlix-standard-page
        templateOptions: #DEFAULT#
        cssClasses: ch-page
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Polling do chat: a cada 1 s pergunta ao servidor (CH_VERIFICAR_MSGS) qual é a
            // assinatura da conversa aberta e só recarrega a região Mensagens quando ela é
            // diferente da que está na tela. Ver modulos/chat/Etapas-chat.md §1.
            const chChat = (function () {
                const REGIAO_ID         = "msgs"; // Static ID da região Mensagens (passo 1.1, item 4)
                const INTERVALO_MS      = 1000;  // 1 s
                const INTERVALO_ERRO_MS = 5000;  // depois de um erro de rede, espera mais
                const FOLGA_FIM_PX      = 40;    // "está no fim" = a menos de 40 px do fim
                const LIMITE_REFRESH_MS = 10000; // destrava se um refresh nunca terminar
            
                let timer          = null;
                let consultando    = false; // há uma chamada ao CH_VERIFICAR_MSGS em andamento
                let atualizandoDes = 0;     // quando começou o refresh da região (0 = nenhum)
                let forcarFim      = false; // próximo refresh rola até o fim (envio de mensagem)
                let irAoFim        = true;
                let topoSalvo      = 0;
                let canalNaTela    = null;  // canal cujas mensagens estão renderizadas
            
                function canalAtual() {
                    return apex.item("P4_CANAL_ID").getValue();
                }
            
                // Elemento da região Mensagens. Usa o Static ID "msgs" se ele vier no HTML;
                // senão, sobe a partir do relatório (report_<id>_catch) até o id interno R<id>.
                // Assim o polling funciona mesmo que o Static ID não chegue à página.
                function regiaoEl() {
                    const porId = document.getElementById(REGIAO_ID);
                    if (porId) {
                        return porId;
                    }
                    const relatorio = document.querySelector(".ch-chat [id^='report_'][id$='_catch']");
                    return relatorio ? relatorio.closest("[id^='R']") : null;
                }
            
                function lista() {
                    const el = regiaoEl();
                    return el ? el.querySelector(".ch-msgs") : null;
                }
            
                function atualizando() {
                    return atualizandoDes > 0 && Date.now() - atualizandoDes < LIMITE_REFRESH_MS;
                }
            
                // mesma regra do CH_VERIFICAR_MSGS: "<id da última mensagem>:<quantidade>"
                function assinaturaNaTela() {
                    const el     = regiaoEl();
                    const msgs   = el ? el.querySelectorAll(".ch-msg[data-id]") : [];
                    const ultima = msgs.length ? msgs[msgs.length - 1].dataset.id : "0";
                    return ultima + ":" + msgs.length;
                }
            
                function recarregar() {
                    const el = regiaoEl();
                    if (!el) {
                        console.warn("chChat: região Mensagens não encontrada na página");
                        return;
                    }
                    apex.region(el.id).refresh();
                }
            
                function agendar(ms) {
                    clearTimeout(timer);
                    timer = setTimeout(verificar, ms === undefined ? INTERVALO_MS : ms);
                }
            
                function verificar() {
                    const canal = canalAtual();
            
                    // sem conversa aberta, aba escondida ou algo já em andamento: só reagenda
                    if (!canal || document.hidden || consultando || atualizando()) {
                        agendar();
                        return;
                    }
            
                    consultando = true;
                    let espera = INTERVALO_MS;
            
                    apex.server.process("CH_VERIFICAR_MSGS", { x01: canal }, { dataType: "json" })
                        .done(function (resp) {
                            // trocou de conversa enquanto a resposta vinha, ou já há refresh: ignora
                            if (canal !== canalAtual() || atualizando()) {
                                return;
                            }
                            if (resp && resp.assinatura !== assinaturaNaTela()) {
                                // try/catch: um erro aqui não pode impedir o .always de liberar o ciclo
                                try {
                                    recarregar();
                                } catch (e) {
                                    console.error("chChat: falha ao atualizar a conversa", e);
                                }
                            }
                        })
                        .fail(function () {
                            espera = INTERVALO_ERRO_MS;
                        })
                        .always(function () {
                            consultando = false;
                            agendar(espera);
                        });
                }
            
                // vale para qualquer refresh da região: polling, abrir contato e enviar
                function antesDoRefresh() {
                    atualizandoDes = Date.now();
                    const l = lista();
                    const outraConversa = canalNaTela !== canalAtual();
                    irAoFim = forcarFim || outraConversa || !l ||
                              l.scrollHeight - l.scrollTop - l.clientHeight < FOLGA_FIM_PX;
                    topoSalvo = l ? l.scrollTop : 0;
                }
            
                function depoisDoRefresh() {
                    const l = lista();
                    if (l) {
                        l.scrollTop = irAoFim ? l.scrollHeight : topoSalvo;
                    }
                    canalNaTela    = canalAtual();
                    forcarFim      = false;
                    atualizandoDes = 0;
                    agendar(); // a próxima verificação conta a partir de agora
                }
            
                // só reage aos eventos da região Mensagens (a lista de contatos também é relatório).
                // "contains" e não "===": o relatório dispara o evento num elemento DENTRO da
                // região (report_<id>_catch), e ele sobe até o document.
                function daRegiao(evento) {
                    const el = regiaoEl();
                    return !!el && el.contains(evento.target);
                }
            
                function iniciar() {
                    // ligado no document: funciona com qualquer id que a região tenha
                    apex.jQuery(document)
                        .on("apexbeforerefresh", function (e) { if (daRegiao(e)) { antesDoRefresh(); } })
                        .on("apexafterrefresh",  function (e) { if (daRegiao(e)) { depoisDoRefresh(); } });
            
                    // voltou para a aba: verifica na hora em vez de esperar o próximo ciclo
                    document.addEventListener("visibilitychange", function () {
                        if (!document.hidden) {
                            agendar(0);
                        }
                    });
            
                    agendar();
                }
            
                return {
                    iniciar: iniciar,
                    // chamado pela DA "Enviar Mensagem": quem envia quer ver a própria mensagem
                    irParaFim: function () { forcarFim = true; }
                };
            })();
            ```
        executeWhenPageLoads: chChat.iniciar();
    }
    css {
        inline:
            ```css
            /* ============================================
               CHAT — Página 4
               ============================================ */
            
            :root {
                --ch-topbar-h: 40px;
                --ch-list-w: 260px;
            
                --ch-blue: var(--cx-primaria);
                --ch-blue-soft: var(--cx-primaria-suave);
                --ch-bubble-in: var(--cx-tag);
            
                --ch-border: var(--cx-borda);
                --ch-surface: var(--cx-superficie-2);
            
                --ch-text: var(--cx-texto);
                --ch-text-dim: var(--cx-texto-2);
                --ch-text-faint: var(--cx-texto-3);
            
                --ch-avatar-bg: var(--cx-primaria-suave);
                --ch-avatar-fg: var(--cx-primaria);
            
                --ch-online: #22C55E;
                --ch-ausente: #F59E0B;
                --ch-offline: #D1D5DB;
            
                --ch-radius: var(--cx-raio-card);
                --ch-avatar-size: 34px;
            }
            
            /* ---- reset do container do Universal Theme ---- */
            html,
            body {
                height: 100%;
            }
            
            .ch-page .t-Body-content,
            .ch-page .t-Body-contentInner,
            .ch-page .t-Body-main {
                padding: 0 !important;
                margin: 0 !important;
                max-width: none;
            }
            
            .ch-page .t-Body-content {
                overflow: hidden;
            }
            
            /* ---- estrutura de duas colunas ---- */
            .ch-shell {
                display: grid;
                grid-template-columns: var(--ch-list-w) 1fr;
                grid-template-rows: minmax(0, 1fr); /* impede a linha de crescer */
                height: calc(100vh - var(--ch-topbar-h));
                overflow: hidden;
                background: #fff;
            }
            
            /* wrappers do APEX (.container/.row, inclusive os internos) somem do layout:
               .ch-list e .ch-chat viram itens do grid, e as colunas internas viram
               itens flex direto da região Conversa */
            .ch-shell>div,
            .ch-shell .container,
            .ch-shell .row {
                display: contents;
            }
            
            /* ============================================
               Coluna de contatos
               ============================================ */
            
            .ch-list {
                background: #fff;
                border-right: 1px solid var(--ch-border);
                display: flex;
                flex-direction: column;
                min-height: 0;
                overflow: hidden;
            }
            
            /* repassa a altura: região → #report_catch */
            .ch-list>div,
            .ch-list>div>div {
                display: flex;
                flex-direction: column;
                flex: 1 1 auto;
                min-height: 0;
            }
            
            .ch-contacts {
                display: flex;
                flex-direction: column;
                flex: 1 1 auto;
                min-height: 0;
                overflow-y: auto;
            }
            
            /* cabeçalho do departamento: botão que abre/fecha o grupo */
            .ch-dept {
                position: sticky;
                top: 0;
                z-index: 1;
                flex: 0 0 auto;
                display: flex;
                align-items: center;
                gap: 8px;
                width: 100%;
                padding: 10px 16px;
                border: none;
                border-top: 1px solid var(--ch-border);
                border-bottom: 1px solid var(--ch-border);
                background: var(--ch-surface);
                font: inherit;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: .04em;
                text-transform: uppercase;
                text-align: left;
                color: var(--ch-text-dim);
                cursor: pointer;
            }
            
            .ch-dept:first-child {
                border-top: none;
            }
            
            .ch-dept:hover {
                color: var(--ch-text);
            }
            
            .ch-dept:focus-visible {
                outline: 2px solid var(--ch-blue);
                outline-offset: -2px;
            }
            
            .ch-dept-ico {
                font-size: 10px;
                transition: transform .15s ease;
            }
            
            .ch-dept[aria-expanded="true"] .ch-dept-ico {
                transform: rotate(90deg);
            }
            
            .ch-dept-nome {
                flex: 1 1 auto;
                min-width: 0;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            
            .ch-dept-qtd {
                flex: 0 0 auto;
                font-weight: 500;
                letter-spacing: 0;
                color: var(--ch-text-faint);
            }
            
            /* departamentos começam colapsados; a DA "Abrir/fechar
               marca os contatos do grupo aberto com .is-visivel */
            .ch-contacts .ch-contact:not(.is-visivel) {
                display: none;
            }
            
            .ch-contact {
                display: flex;
                flex: 0 0 auto;
                align-items: center;
                gap: 10px;
                padding: 10px 16px;
                text-decoration: none;
                color: inherit;
                border-left: 3px solid transparent;
                transition: background .12s ease;
            }
            
            .ch-contact:hover {
                background: var(--ch-surface);
            }
            
            .ch-contact:focus-visible {
                outline: 2px solid var(--ch-blue);
                outline-offset: -2px;
            }
            
            .ch-contact.is-active {
                background: var(--ch-blue-soft);
                border-left-color: var(--ch-blue);
            }
            
            /* ---- avatar + status (lista e cabeçalho da conversa) ---- */
            .ch-avatar-wrap {
                position: relative;
                flex: 0 0 var(--ch-avatar-size);
            }
            
            .ch-avatar {
                position: relative;
                width: var(--ch-avatar-size);
                height: var(--ch-avatar-size);
                border-radius: 50%;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: 600;
                background: var(--ch-avatar-bg);
                color: var(--ch-avatar-fg);
            }
            
            /* foto por cima das iniciais; se falhar, o onerror remove a <img> */
            .ch-avatar img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 50%;
            }
            
            .ch-dot {
                position: absolute;
                right: -1px;
                bottom: -1px;
                width: 10px;
                height: 10px;
                border-radius: 50%;
                border: 2px solid #fff;
            }
            
            .ch-dot--online  { background: var(--ch-online); }
            .ch-dot--ausente { background: var(--ch-ausente); }
            .ch-dot--offline { background: var(--ch-offline); }
            
            /* nome e cargo cortam com reticências em vez de quebrar a linha */
            .ch-contact-txt {
                display: flex;
                flex-direction: column;
                min-width: 0;
            }
            
            .ch-contact-txt b,
            .ch-contact-txt small {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            
            .ch-contact-txt b {
                font-size: 13px;
                font-weight: 600;
                color: var(--ch-text);
            }
            
            .ch-contact-txt small {
                font-size: 11px;
                color: var(--ch-text-dim);
            }
            
            /* ============================================
               Painel de conversa
               ============================================ */
            
            .ch-chat {
                display: flex;
                flex-direction: column;
                min-height: 0;
                overflow: hidden;
                background: #fff;
            }
            
            /* repassa a altura pela cadeia de wrappers até .ch-msgs.
               O :not(.ch-composer) impede que o composer vire coluna e cresça. */
            .ch-chat>div,
            .ch-chat .col,
            .ch-chat .col>div,
            .ch-chat .col>div>div:not(.ch-composer) {
                display: flex;
                flex-direction: column;
                flex: 1 1 auto;
                min-height: 0;
            }
            
            /* coluna do composer: altura do conteúdo, sempre no rodapé.
               :has() funciona com a classe ch-composer-col na linha ou na coluna. */
            .ch-chat .col:has(.ch-composer) {
                flex: 0 0 auto;
                margin-top: auto;
            }
            
            /* ---- estado vazio (nenhum contato selecionado) ---- */
            .ch-vazio {
                flex: 1 1 auto;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 6px;
                padding: 24px;
                text-align: center;
                color: var(--ch-text-dim);
            }
            
            .ch-vazio .fa {
                font-size: 40px;
                color: var(--ch-text-faint);
                margin-bottom: 6px;
            }
            
            .ch-vazio b {
                font-size: 14px;
                font-weight: 600;
                color: var(--ch-text);
            }
            
            .ch-vazio small {
                font-size: 12px;
            }
            
            /* ---- cabeçalho da conversa (contato aberto) ---- */
            .ch-head {
                display: flex;
                flex: 0 0 auto;
                align-items: center;
                gap: 10px;
                padding: 10px 24px;
                border-bottom: 1px solid var(--ch-border);
                background: #fff;
            }
            
            /* sem contato: só o estado vazio; com contato: cabeçalho + mensagens + composer */
            .ch-chat:not(.is-aberto) .ch-head,
            .ch-chat:not(.is-aberto) .container {
                display: none !important;
            }
            
            .ch-chat.is-aberto .ch-vazio {
                display: none;
            }
            
            /* ---- mensagens ---- */
            .ch-msgs {
                flex: 1 1 auto;
                min-height: 0;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                gap: 18px;
                padding: 24px;
                background: #fff;
            }
            
            /* "nenhuma mensagem" do relatório */
            .ch-chat .nodatafound {
                padding: 24px;
                text-align: center;
                font-size: 13px;
                color: var(--ch-text-faint);
            }
            
            .ch-sep {
                flex: 0 0 auto;
                margin: 6px 0;
                text-align: center;
            }
            
            .ch-sep span {
                font-size: 11px;
                font-weight: 600;
                letter-spacing: .04em;
                color: var(--ch-text-faint);
            }
            
            .ch-msg {
                display: flex;
                flex: 0 0 auto;
            }
            
            .ch-msg--out {
                justify-content: flex-end;
            }
            
            .ch-bubble {
                max-width: 420px;
                padding: 10px 13px;
                border-radius: var(--ch-radius);
                font-size: 13px;
                line-height: 1.45;
                overflow-wrap: anywhere;
            }
            
            .ch-msg--in .ch-bubble {
                background: var(--ch-bubble-in);
                color: var(--ch-text);
                border-top-left-radius: 4px;
            }
            
            .ch-msg--out .ch-bubble {
                background: var(--ch-blue);
                color: #fff;
                border-top-right-radius: 4px;
            }
            
            .ch-txt {
                display: block;
                white-space: pre-wrap;
            }
            
            .ch-time {
                display: block;
                margin-top: 5px;
                font-size: 11px;
                opacity: .6;
            }
            
            /* ---- campo de envio (rodapé da conversa) ---- */
            .ch-composer {
                display: flex;
                flex: 0 0 auto;
                align-items: flex-end;
                gap: 10px;
                padding: 12px 24px 30px; /* folga extra embaixo, longe da borda da página */
                border-top: 1px solid var(--ch-border);
                background: #fff;
            }
            
            .ch-composer textarea {
                flex: 1 1 auto;
                min-width: 0;
                min-height: 40px;
                max-height: 140px;
                padding: 9px 12px;
                border: 1px solid var(--ch-border);
                border-radius: var(--ch-radius);
                font: inherit;
                font-size: 13px;
                line-height: 1.45;
                color: var(--ch-text);
                resize: none;
            }
            
            .ch-composer textarea:focus {
                outline: none;
                border-color: var(--ch-blue);
            }
            
            .ch-enviar {
                flex: 0 0 auto;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                height: 40px;
                padding: 0 16px;
                border: none;
                border-radius: var(--ch-radius);
                background: var(--ch-blue);
                color: #fff;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
            }
            
            .ch-enviar:focus-visible {
                outline: 2px solid var(--ch-blue);
                outline-offset: 2px;
            }
            
            .ch-enviar:disabled {
                opacity: .6;
                cursor: default;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region chat-shell_1 (
        name: Chat Shell
        type: staticContent
        layout {
            sequence: 10
            slot: body
            columnCssClasses: ch-shell
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region composer (
        name: Composer
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ch-composer">
                  <textarea id="ch-texto" rows="1" maxlength="4000"
                            placeholder="Escreva uma mensagem… (Enter envia, Shift+Enter quebra linha)"
                            aria-label="Mensagem"></textarea>
                  <button type="button" class="ch-enviar">
                    <span class="fa fa-paper-plane" aria-hidden="true"></span> Enviar
                  </button>
                </div>
                ```
        }
        layout {
            sequence: 20
            parentRegion: @conversa
            slot: subRegions
            rowCssClasses: ch-composer-col
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region contatos (
        name: Lista
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.nome                          as departamento,
                       c.id_colaborador,
                       c.nome_completo,
                       cg.nome                         as cargo,
                       -- caminho relativo a #APP_FILES# (o prefixo fica no template chat-contatos);
                       -- sem foto, nulo: a <img> falha e ficam as iniciais
                       case
                         when trim(c.foto_url) is null
                              or c.foto_url = '#APP_FILES#Fotos Colaboradores/' then null
                         else apex_page.get_url(p_page => 44, p_x01 => regexp_substr(trim(c.foto_url), '[^/]+$'))
                       end                              as foto_url,
                       upper(
                         substr(trim(nvl(c.primeiro_nome, c.nome_completo)), 1, 1) ||
                         substr(trim(nvl(c.ultimo_nome,
                           substr(trim(c.nome_completo), nullif(instr(trim(c.nome_completo), ' ', -1), 0) + 1))), 1, 1)
                       )                                as iniciais,
                       case
                         when p.data_ultimo_ping > systimestamp - interval '5' minute
                              and upper(p.status_presenca) = 'ONLINE' then 'online'
                         when p.data_ultimo_ping > systimestamp - interval '30' minute
                              then 'ausente'
                         else 'offline'
                       end                              as presenca,
                       case when row_number() over (
                            partition by d.nome
                            order by c.nome_completo
                          ) = 1
                        then '<button type="button" class="ch-dept" aria-expanded="false">' ||
                            '<span class="fa fa-chevron-right ch-dept-ico" aria-hidden="true"></span>' ||
                            '<span class="ch-dept-nome">' || apex_escape.html(d.nome) || '</span>' ||
                            '<span class="ch-dept-qtd">' || count(*) over (partition by d.nome) || '</span>' ||
                          '</button>'
                        end                              as cab_dept
                from   colaborador  c
                join   departamento d  on d.id_departamento = c.id_departamento
                left   join cargo   cg on cg.id_cargo       = c.id_cargo
                left   join presenca_colaborador p on p.id_colaborador = c.id_colaborador
                where  c.status = true
                and    nvl(upper(c.login_apex),'x') != upper(:APP_USER)
                -- só colaboradores da mesma empresa do usuário logado
                and    c.id_empresa = (
                         select eu.id_empresa
                         from   colaborador eu
                         where  upper(eu.login_apex) = upper(:APP_USER)
                         fetch  first 1 row only
                       )
                order  by d.nome, c.nome_completo
                ```
        }
        layout {
            sequence: 10
            parentRegion: @chat-shell_1
            slot: subRegions
            columnCssClasses: ch-list
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @chat-contatos
        }
        breakFormatting {
            breakColumns: col1
        }

        column CAB_DEPT (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Cab Dept
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column CARGO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Cargo
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column DEPARTAMENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Departamento
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

