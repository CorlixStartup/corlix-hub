            icon: fa-arrow-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
            }
        }
    )

    dynamicAction atualizar-comunicados (
        name: Atualizar comunicados
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @novo-comunicado
        }

        action atualizar-comunicados (
            name: Atualizar comunicados
            action: refresh
            affectedElements {
                selectionType: region
                region: @home_comunicados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p9-mes-atual (
        itemName: P1_MES_ATUAL
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            type: expression
            plsqlExpression:
                ```plsql
                pkg_home_ui.mes_atual
                
                ```
        }
    )

    process registrar-marcacao (
        name: REGISTRAR_MARCACAO
        type: executeCode
        source {
            plsqlCode: pkg_ponto_ui.ajax_registrar(apex_application.g_x01);
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 47612812573452018
        }
        security {
            authorizationScheme: @colaborador
        }
    )

)

