    pageItem P1_MES_ATUAL (
        type: hidden
        layout {
            sequence: 100
            region: @coluna-lateral
            slot: regionBody
        }
    )

    button novo-comunicado (
        buttonName: NOVO_COMUNICADO
        label: Novo comunicado
        layout {
            sequence: 20
            region: @home_comunicados
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 17
                clearCache: 17
            }
        }
        security {
            authorizationScheme: @publicador-de-conteudo
        }
    )

    button ver-todos (
        buttonName: VER_TODOS
        label: Ver todos
        layout {
            sequence: 10
            region: @home_comunicados
            slot: copy
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
