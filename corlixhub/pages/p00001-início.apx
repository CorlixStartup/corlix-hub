    region home_aniversariantes (
        name: Celebrações
        title: <span class="fa fa-birthday-cake" aria-hidden="true"></span>Celebrações de &P1_MES_ATUAL.
        type: dynamicContent
        source {
            plsqlFunctionBody: return pkg_home_ui.render_celebracoes;
        }
        layout {
            sequence: 40
            parentRegion: @coluna-lateral
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: cx-home-card
        }
    )

    region home_comunicados (
        name: Comunicados
        title: Comunicados<span class="cx-home-card__subtitulo">Publicações oficiais da empresa&P1_NAO_LIDOS.</span>
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.id_comunicado,
                       c.titulo,
                       substr(trim(regexp_replace(regexp_replace(dbms_lob.substr(c.conteudo, 1000, 1),
                                                                 '<[^>]+>', ' '),
                                                  '\s+', ' ')), 1, 220) as resumo,
                       c.imagem,
                       c.mime_type,
                       'Para: ' || nvl(d.nome, 'Todos') as publico,
                       to_char(c.data_publicacao, 'fmdd') || ' de '
                         || to_char(c.data_publicacao, 'fmmonth', 'NLS_DATE_LANGUAGE=''BRAZILIAN PORTUGUESE''')
                         || case when extract(year from c.data_publicacao) <> extract(year from sysdate)
                                 then ' de ' || to_char(c.data_publicacao, 'yyyy')
                            end as data_publicacao_txt,
                       case when c.data_publicacao >= trunc(sysdate) - 7 then 'Novo' end as selo,
                       k.nm_categoria as categoria,
                       -- "Não lido": só para quem tem colaborador e ainda não abriu
                       case when eu.id_colaborador is not null
                             and not exists (select 1 from comunicado_leitura l
                                              where l.id_comunicado = c.id_comunicado
                                                and l.id_colaborador = eu.id_colaborador)
                            then 'S' end as nao_lido
                  from comunicado c
                  left join departamento d
                    on d.id_departamento = c.id_departamento
                  left join categoria_comunicado k
                    on k.id_categoria = c.id_categoria
                  left join colaborador eu
                    on upper(trim(eu.login_apex)) = upper(trim(:APP_USER))
                   and eu.id_empresa = c.id_empresa
                 where c.id_empresa = :G_ID_EMPRESA
                 order by case c.fl_fixado when 'S' then 0 else 1 end, c.data_publicacao desc, c.id_comunicado desc
                 fetch first 5 rows only
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @coluna-principal
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: [
                cx-home-card
                cx-home-comunicados
                cx-home-carrossel
            ]
        }
        componentAppearance {
            layout: horizontal
        }
        card {
            primaryKeyColumn1: ID_COMUNICADO
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <span class="cx-home-comunicado__meta">
                  {if SELO/}<span class="cx-badge cx-badge--info">&SELO.</span>{endif/}
                  {if CATEGORIA/}<span class="cx-etiqueta">&CATEGORIA.</span>{endif/}
                  <span class="cx-home-comunicado__para">&PUBLICO. · &DATA_PUBLICACAO_TXT.</span>
                </span>
                <span class="cx-home-comunicado__titulo">&TITULO.</span>
                
                ```
        }
        body {
            advancedFormatting: true
            htmlExpression:
                ```html
                &RESUMO.{if NAO_LIDO/}<span class="cx-home-nao-lido" data-cx-nao-lido>Não lido</span>{endif/}
                
                ```
        }
        media {
            source: blobColumn
            blobColumn: IMAGEM
            position: first
            sizing: cover
        }
        blobAttributes {
            mimeTypeColumn: MIME_TYPE
        }
        messages {
            whenNoDataFound: Nenhum comunicado publicado. Os comunicados oficiais aparecerão aqui.
        }

        action action (
            label: Ler comunicado
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 11
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-arrow-right
            }
        )

    )

