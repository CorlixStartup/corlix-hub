page 42 (
    name: Artigos
    alias: ARTIGOS
    title: Artigos
    appearance {
        pageTemplate: @corlix-standard-page
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @suporte-ti
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region artigos (
        name: Artigos
        type: interactiveReport
        source {
            location: localDatabase
            tableName: SUPORTE_ARTIGO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 43
                items: {
                    P43_ID_ARTIGO: \#ID_ARTIGO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 47667284536854463
        }

        column DH_ATUALIZACAO (
            type: plainText
            heading {
                heading: Dh Atualizacao
            }
            layout {
                sequence: 11
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
        )

        column DS_CORPO (
            type: plainText
            heading {
                heading: Ds Corpo
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DS_PALAVRAS (
            type: plainText
            heading {
                heading: Ds Palavras
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DS_RESUMO (
            type: plainText
            heading {
                heading: Ds Resumo
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column DS_TITULO (
            type: plainText
            heading {
                heading: Ds Titulo
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column FL_PUBLICADO (
            type: plainText
            heading {
                heading: Fl Publicado
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ID_ARTIGO (
            type: hidden
            heading {
                heading: Id Artigo
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_ASSUNTO (
            type: plainTextBasedOnLov
            heading {
                heading: Id Assunto
            }
            lov {
                lov: @suporte-assunto-nm-assunto
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_EMPRESA (
            type: plainTextBasedOnLov
            heading {
                heading: Id Empresa
            }
            lov {
                lov: @empresa-nome
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column NR_ACESSOS (
            type: plainText
            heading {
                heading: Nr Acessos
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column NR_MIN_LEITURA (
            type: plainText
            heading {
                heading: Nr Min Leitura
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990D0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column USR_ATUALIZACAO (
            type: plainText
            heading {
                heading: Usr Atualizacao
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @artigos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 43
                clearCache: 43
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @artigos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @artigos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

