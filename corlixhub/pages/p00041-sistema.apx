page 41 (
    name: Sistema
    alias: SISTEMA
    title: Sistema
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @suporte-ti
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region sistema (
        name: Sistema
        type: form
        source {
            location: localDatabase
            tableName: SUPORTE_SISTEMA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P41_DS_AVISO_TEXTO (
        type: textarea
        label {
            label: Texto do aviso
            alignment: left
        }
        layout {
            sequence: 80
            region: @sistema
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 450
        }
        source {
            formRegion: @sistema
            column: DS_AVISO_TEXTO
            dataType: varchar2
        }
        help {
            inlineHelpText: Ex.: A equipe já está atuando, não é preciso abrir chamado. Próxima atualização às 15:00.
        }
    )

    pageItem P41_DS_AVISO_TITULO (
        type: textField
        label {
            label: Título do aviso
            alignment: left
        }
        layout {
            sequence: 70
            region: @sistema
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 140
        }
        source {
            formRegion: @sistema
            column: DS_AVISO_TITULO
            dataType: varchar2
        }
        help {
            inlineHelpText: Preencha para mostrar o aviso no topo da página. Ex.: Instabilidade na VPN desde 13:40.
        }
    )

    pageItem P41_DS_DETALHE (
        type: textField
        label {
            label: Detalhe
            alignment: left
        }
        layout {
            sequence: 60
            region: @sistema
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 140
        }
        source {
            formRegion: @sistema
            column: DS_DETALHE
            dataType: varchar2
        }
        help {
            inlineHelpText: Ex.: Desde 13:40 · equipe atuando. Só aparece quando o sistema não está operando.
        }
    )

    pageItem P41_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @sistema
            slot: regionBody
        }
        source {
            formRegion: @sistema
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: item
            item: G_ID_EMPRESA
        }
    )

    pageItem P41_ID_SISTEMA (
        type: hidden
        layout {
            sequence: 10
            region: @sistema
            slot: regionBody
        }
        source {
            formRegion: @sistema
            column: ID_SISTEMA
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P41_NM_SISTEMA (
        type: textField
        label {
            label: Sistema
            alignment: left
        }
        layout {
            sequence: 30
            region: @sistema
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @sistema
            column: NM_SISTEMA
            dataType: varchar2
        }
    )

    pageItem P41_NR_ORDEM (
        type: numberField
        label {
            label: Ordem na lista
            alignment: left
        }
        layout {
            sequence: 40
            region: @sistema
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @sistema
            column: NR_ORDEM
            dataType: number
        }
    )

    pageItem P41_ST_SISTEMA (
        type: selectList
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Operando;OPERANDO,Instável;INSTAVEL,Em manutenção;MANUTENCAO,Fora do ar;FORA
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @sistema
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @sistema
            column: ST_SISTEMA
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P41_ID_SISTEMA
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_ID_SISTEMA
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_ID_SISTEMA
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 47639173599539545
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-sistema (
        name: Initialize form Sistema
        type: formInitialization
        formRegion: @sistema
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 47638358798539543
        }
    )

    process process-form-sistema (
        name: Process form Sistema
        type: formAutoRowProcessing
        formRegion: @sistema
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 47638703713539544
        }
    )

)

