page 0 (
    name: Global Page

    region novo (
        name: Barra de Busca
        type: dynamicContent
        source {
            plsqlFunctionBody: return pkg_busca_ui.render_campo;
        }
        layout {
            sequence: 10
            slot: afterLogo
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
    )

    region perfil (
        name: Perfil
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="corlix-header__actions">
                  <a href="f?p=&APP_ID.:NOTIFICACOES:&SESSION." class="corlix-header__icon-btn"
                     aria-label="Notificações" title="Notificações">
                    <span class="fa fa-bell-o" aria-hidden="true"></span>
                  </a>
                  <span class="corlix-header__divisor" aria-hidden="true"></span>
                  <button type="button" class="corlix-header__user" popovertarget="cx-menu-usuario"
                          aria-haspopup="menu" aria-label="Menu do usuário">
                    <img src="&APP_USER_FOTO!ATTR." alt="" class="corlix-header__avatar"
                         onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='';" />
                    <span class="corlix-header__avatar cx-avatar-iniciais" aria-hidden="true" style="display:none">&APP_USER_INICIAIS.</span>
                    <span class="corlix-header__user-name">&G_NOME_USUARIO.</span>
                    <span class="fa fa-chevron-down corlix-header__user-seta" aria-hidden="true"></span>
                  </button>
                  <div id="cx-menu-usuario" class="cx-menu-usuario" popover>
                    <div class="cx-menu-usuario__cabecalho">
                      <span class="cx-menu-usuario__nome">&G_NOME_USUARIO.</span>
                      <span class="cx-menu-usuario__info"><span class="cx-menu-usuario__login">&APP_USER.</span> · &G_NOME_EMPRESA.</span>
                    </div>
                    <hr class="cx-menu-usuario__separador">
                    <a class="cx-menu-usuario__item" href="f?p=&APP_ID.:MEU-PERFIL:&SESSION.">
                      <span class="fa fa-user-o" aria-hidden="true"></span>Meu perfil
                    </a>
                    <hr class="cx-menu-usuario__separador">
                    <a class="cx-menu-usuario__item" href="&LOGOUT_URL.">
                      <span class="fa fa-sign-out" aria-hidden="true"></span>Sair
                    </a>
                  </div>
                </div>
                
                ```
        }
        layout {
            sequence: 10
            slot: afterNavigationBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
    )

    dynamicAction presença (
        name: Presença
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: userIsAuthenticated
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (window.cxPresenca || window.self !== window.top) {
                        return;
                    }
                    
                    const PROCESSO     = "CX_PRESENCA_PING";
                    const INTERVALO_MS = 60000;
                    const ATIVIDADE_MS = 180000;
                    const CICLO_MS     = 15000;
                    const CHAVE        = "cxPresencaUltimoPing";
                    
                    let ultimaAtividade = Date.now();
                    let enviando        = false;
                    
                    function lerUltimoPing() {
                        try {
                            return Number(sessionStorage.getItem(CHAVE)) || 0;
                        } catch (e) {
                            return 0;
                        }
                    }
                    
                    function gravarUltimoPing(momento) {
                        try {
                            sessionStorage.setItem(CHAVE, String(momento));
                        } catch (e) {
                            // sem storage: só pinga a cada carregamento de página
                        }
                    }
                    
                    function ping() {
                        const agora = Date.now();
                        if (enviando ||
                            document.hidden ||
                            agora - ultimaAtividade > ATIVIDADE_MS ||
                            agora - lerUltimoPing() < INTERVALO_MS) {
                            return;
                        }
                    
                        enviando = true;
                        apex.server.process(PROCESSO, {}, { dataType: "json", loadingIndicator: null })
                            .done(function () {
                                gravarUltimoPing(Date.now());
                            })
                            .always(function () {
                                enviando = false;
                            });
                    }
                    
                    function marcarAtividade() {
                        const estavaParado = Date.now() - ultimaAtividade > ATIVIDADE_MS;
                        ultimaAtividade = Date.now();
                        if (estavaParado) {
                            ping();
                        }
                    }
                    
                    ["pointerdown", "pointermove", "keydown", "wheel", "touchstart"].forEach(function (evento) {
                        document.addEventListener(evento, marcarAtividade, { passive: true, capture: true });
                    });
                    
                    document.addEventListener("visibilitychange", function () {
                        if (!document.hidden) {
                            marcarAtividade();
                            ping();
                        }
                    });
                    
                    setInterval(ping, CICLO_MS);
                    ping();
                    
                    window.cxPresenca = { ping: ping };
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

