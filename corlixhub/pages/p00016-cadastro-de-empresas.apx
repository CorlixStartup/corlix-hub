    dynamicAction dados-por-cnpj (
        name: Dados por CNPJ
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P16_CNPJ
        }

        action dados-por-cnpj (
            name: Dados por CNPJ
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var cnpj = this.triggeringElement.value.replace(/\D/g, '');
                    // Só em empresa nova: na edição, não sobrescreve o que já está cadastrado
                    if (cnpj.length !== 14 || apex.item("P16_ID_EMPRESA").getValue()) {
                      return;
                    }
                    
                    var preencher = function (item, valor) {
                      if (valor) {
                        apex.item(item).setValue(valor);
                      }
                    };
                    
                    fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`)
                      .then(response => {
                        if (!response.ok) {
                          throw new Error(response.status);
                        }
                        return response.json();
                      })
                      .then(d => {
                        apex.message.clearErrors();
                        preencher("P16_NOME", d.razao_social);
                        preencher("P16_NOME_FANTASIA", d.nome_fantasia);
                        if (d.data_inicio_atividade) {
                          var [ano, mes, dia] = d.data_inicio_atividade.split("-");
                          preencher("P16_DATA_CRIACAO", `${dia}/${mes}/${ano}`);
                        }
                        preencher("P16_EMAIL_CORPORATIVO", (d.email || "").toLowerCase());
                        preencher("P16_TELEFONE", d.ddd_telefone_1);
                        preencher("P16_CEP", d.cep);
                        preencher("P16_LOGRADOURO", [d.descricao_tipo_de_logradouro, d.logradouro].filter(Boolean).join(" "));
                        preencher("P16_NUMERO", d.numero);
                        preencher("P16_COMPLEMENTO", d.complemento);
                        preencher("P16_BAIRRO", d.bairro);
                        preencher("P16_CIDADE", d.municipio);
                        preencher("P16_UF", d.uf);
                      })
                      .catch(() => {
                        apex.message.showErrors([{
                          type: "error",
                          location: "inline",
                          pageItem: "P16_CNPJ",
                          message: "Não encontramos este CNPJ na Receita Federal. Confira o número ou preencha os dados à mão.",
                          unsafe: false
                        }]);
                      });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction endereço-por-cep (
        name: Endereço por CEP
        execution {
            sequence: 10
        }
        when {
            event: keyup
            selectionType: items
            items: P16_CEP
        }

        action quando-cep-for-verdade (
            name: Quando CEP for verdade
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var cep = this.triggeringElement.value.replace(/\D/g, '');
                    if (cep.length !== 8) {
                      return;
                    }
                    
                    fetch(`https://viacep.com.br/ws/${cep}/json/`)
                      .then(response => response.json())
                      .then(data => {
                        apex.message.clearErrors();
                        if (data.erro) {
                          apex.message.showErrors([{
                            type: "error",
                            location: "inline",
                            pageItem: "P16_CEP",
                            message: "CEP não encontrado. Confira o número ou preencha o endereço à mão.",
                            unsafe: false
                          }]);
                          return;
                        }
                        apex.item("P16_LOGRADOURO").setValue(data.logradouro);
                        apex.item("P16_BAIRRO").setValue(data.bairro);
                        apex.item("P16_CIDADE").setValue(data.localidade);
                        apex.item("P16_UF").setValue(data.uf);
                        apex.item(data.logradouro ? "P16_NUMERO" : "P16_LOGRADOURO").setFocus();
                      })
                      .catch(() => {
                        apex.message.showErrors([{
                          type: "error",
                          location: "inline",
                          pageItem: "P16_CEP",
                          message: "Não foi possível consultar o CEP agora. Preencha o endereço à mão.",
                          unsafe: false
                        }]);
                      });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation cep-com-8-dígitos (
        name: CEP com 8 dígitos
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: "regexp_like(:P16_CEP, '^[0-9]{8}$')"
        }
        error {
            errorMessage: Informe o CEP com 8 dígitos.
            associatedItem: @P16_CEP
        }
    )

    validation cnpj-com-14-dígitos (
        name: CNPJ com 14 dígitos
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: "length(regexp_replace(:P16_CNPJ, '[^0-9]')) = 14"
        }
        error {
            errorMessage: Informe os 14 dígitos do CNPJ.
            associatedItem: @P16_CNPJ
        }
    )

    validation cnpj-não-cadastrado (
        name: CNPJ não cadastrado
        execution {
            sequence: 15
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                    l_existe number;
                begin
                    -- Compara só os dígitos: o CNPJ é gravado com a máscara que foi digitada
                    select count(*)
                      into l_existe
                      from empresa
                     where regexp_replace(cnpj, '[^0-9]') = regexp_replace(:P16_CNPJ, '[^0-9]')
                       and (:P16_ID_EMPRESA is null or id_empresa <> to_number(:P16_ID_EMPRESA))
                       and rownum = 1;
                    return l_existe = 0;
                end;
                ```
        }
        error {
            errorMessage: Já existe uma empresa cadastrada com este CNPJ.
            displayLocation: inlineWithField
            associatedItem: @P16_CNPJ
        }
    )

    validation empresa-sem-vínculos (
        name: Empresa sem vínculos
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                    l_existe number;
                begin
                    -- Percorre as FKs para EMPRESA pelo dicionário: tabela nova com FK entra sozinha
                    for fk in (
                        select c.table_name, cc.column_name
                          from user_constraints c
                          join user_constraints p
                            on p.constraint_name = c.r_constraint_name
                          join user_cons_columns cc
                            on cc.constraint_name = c.constraint_name
                         where c.constraint_type = 'R'
                           and c.delete_rule = 'NO ACTION'
                           and p.table_name = 'EMPRESA'
                    ) loop
                        execute immediate
                            'select count(*) from ' || dbms_assert.enquote_name(fk.table_name)
                            || ' where ' || dbms_assert.enquote_name(fk.column_name) || ' = :id'
                            || ' and rownum = 1'
                            into l_existe
                            using to_number(:P16_ID_EMPRESA);
                        if l_existe > 0 then
                            return false;
                        end if;
                    end loop;
                    return true;
                end;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Esta empresa tem colaboradores, departamentos ou outros cadastros vinculados e não pode ser removida. Para tirá-la de uso, desligue a Situação.
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    validation telefone-com-ddd (
        name: Telefone com DDD
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression: "regexp_like(:P16_TELEFONE, '^[0-9]{10,11}$')"
        }
        error {
            errorMessage: Informe o telefone com DDD (10 ou 11 dígitos).
            associatedItem: @P16_TELEFONE
        }
    )

    computation p16-cep (
        itemName: P16_CEP
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: "regexp_replace(:P16_CEP, '[^0-9]')"
        }
    )

    computation p16-telefone (
        itemName: P16_TELEFONE
        execution {
            sequence: 20
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: "regexp_replace(:P16_TELEFONE, '[^0-9]')"
        }
    )

    computation p16-titulo (
        itemName: P16_TITULO
        execution {
            sequence: 20
            point: beforeHeader
        }
        computation {
            type: expression
            plsqlExpression: case when :P16_ID_EMPRESA is null then 'Nova empresa' else 'Editar empresa' end
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
