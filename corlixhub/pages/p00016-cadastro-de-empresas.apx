page 16 (
    name: Cadastro de Empresas
    alias: CADASTRO-DE-EMPRESAS
    title: &P16_TITULO.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            apex.util.getTopApex()
                .jQuery(".ui-dialog-content")
                .dialog("option", "title", apex.item("P16_TITULO").getValue());
            ```
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        title: Ações do formulário
        type: staticContent
        source {
            htmlCode: <p class="cx-form-modal-rodape__nota">Campos marcados com * são obrigatórios.</p>
        }
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
            cssClasses: cx-form-modal-rodape
        }
    )

    region cadastro-de-empresas (
        name: Cadastro de Empresas
        type: form
        source {
            location: localDatabase
            tableName: EMPRESA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: cx-form-modal
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region configurações (
        name: Logotipo e situação
        title: Logotipo e situação
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @cadastro-de-empresas
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--hiddenOverflow
            ]
        }
        headerAndFooter {
            headerText: <h2 class="cx-titulo-secao">Logotipo e situação</h2>
        }
    )

    region contato-e-endereço (
        name: Contato e endereço
