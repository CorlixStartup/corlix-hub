page 2 (
    name: Meu Perfil
    alias: MEU-PERFIL
    title: Meu Perfil
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            const PERFIL_ITEM_ID = "P2_ID_COLABORADOR";
            const PERFIL_AJAX_DRAWER = "PERFIL_DRAWER_FOTO";
            
            let perfilFotoDrawer = null;
            
            function obterFotoDrawer() {
              if (perfilFotoDrawer) return perfilFotoDrawer;
              perfilFotoDrawer = document.createElement("dialog");
              perfilFotoDrawer.className = "org-drawer";
              perfilFotoDrawer.innerHTML = '<div class="org-drawer__painel"></div>';
              document.body.appendChild(perfilFotoDrawer);
              return perfilFotoDrawer;
            }
            
            function abrirDrawerFoto(id) {
              const drawer = obterFotoDrawer();
              const painel = drawer.firstElementChild;
              
              painel.innerHTML = '<div class="org-drawer__estado"><span class="org-spinner"></span><p>Carregando...</p></div>';
              drawer.showModal();
            
              apex.server.process(PERFIL_AJAX_DRAWER, { x01: id }, { dataType: "text" })
                .done(function (html) {
                  painel.innerHTML = html;
                  if (typeof carregarFotosPerfil === "function") {
                    carregarFotosPerfil(painel);
                  }
                });
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            // Função nativa do perfil para resolver os arquivos estáticos do APEX
            function carregarFotosPerfil(container) {
              const base = (apex.env && apex.env.APP_FILES) ? apex.env.APP_FILES : "";
              const el = container || document;
            
              el.querySelectorAll("img[data-perfil-foto]").forEach(img => {
                const nome = img.getAttribute("data-perfil-foto");
                if (nome) {
                  img.src = location.pathname.replace(/[^/]*$/, "") + "foto?session=" + apex.env.APP_SESSION + "&x01=" + encodeURIComponent(nome);
                  img.removeAttribute("data-perfil-foto");
                }
              });
            }
            
            // Carrega as fotos ao abrir a página
            carregarFotosPerfil(document);
            
            // Alternância entre as abas Trajetória e Dados Pessoais
            $(document).on("click", ".perfil-tab-btn", function () {
              $(".perfil-tab-btn").removeClass("is-active");
              $(".perfil-tab-conteudo").removeClass("is-active");
            
              $(this).addClass("is-active");
              $("#tab-" + $(this).data("tab")).addClass("is-active");
            });
            
            // Abertura do Modal de Foto
            $(document).on("click", "[data-acao='abrir-foto-drawer']", function () {
              const id = $v(PERFIL_ITEM_ID) || 0;
              abrirDrawerFoto(id);
            });
            
            $(document).on("click", "[data-acao='fechar-foto']", function () {
              if (perfilFotoDrawer) perfilFotoDrawer.close();
            });
            
            // =============================================================================
            // Corlix Hub · Envio da foto de perfil (página 2)
            // Cole no fim de Page › JavaScript › Execute when Page Loads.
            // O recorte e a conversão acontecem aqui: o JPEG novo sai quadrado e sem
            // metadados, como a localização gravada pelo celular. O servidor confere de novo.
            // =============================================================================
            (function () {
              const c_tamanho = 512;
              const c_max_bytes = 5 * 1024 * 1024;
              let imagemPronta = null;
            
              function aviso(texto, ehErro) {
                const caixa = document.getElementById("perfil-foto-status");
                if (caixa) {
                  caixa.textContent = texto;
                  caixa.classList.toggle("is-erro", !!ehErro);
                }
              }
            
              function botaoSalvar() {
                return document.querySelector("[data-acao='salvar-foto']");
              }
            
              function converter(arquivo) {
                return new Promise(function (resolve, reject) {
                  const endereco = URL.createObjectURL(arquivo);
                  const img = new Image();
                  img.onload = function () {
                    const lado = Math.min(img.naturalWidth, img.naturalHeight);
                    const canvas = document.createElement("canvas");
                    canvas.width = c_tamanho;
                    canvas.height = c_tamanho;
                    canvas.getContext("2d").drawImage(
                      img,
                      (img.naturalWidth - lado) / 2, (img.naturalHeight - lado) / 2, lado, lado,
                      0, 0, c_tamanho, c_tamanho
                    );
                    URL.revokeObjectURL(endereco);
                    canvas.toBlob(function (blob) {
                      if (blob) { resolve(blob); } else { reject(new Error("conversao")); }
                    }, "image/jpeg", 0.85);
                  };
                  img.onerror = function () {
                    URL.revokeObjectURL(endereco);
                    reject(new Error("leitura"));
                  };
                  img.src = endereco;
                });
              }
            
              function paraBase64(blob) {
                return new Promise(function (resolve, reject) {
                  const leitor = new FileReader();
                  leitor.onload = function () { resolve(String(leitor.result).split(",")[1]); };
                  leitor.onerror = reject;
                  leitor.readAsDataURL(blob);
                });
              }
            
              function mostrarPrevia(blob) {
                const caixa = document.querySelector(".perfil-modal-avatar .perfil-avatar");
                if (!caixa) { return; }
                let img = caixa.querySelector("img");
                if (!img) {
                  img = document.createElement("img");
                  img.alt = "";
                  caixa.appendChild(img);
                }
                img.src = URL.createObjectURL(blob);
              }
            
              $(document).on("change", "#input-foto-upload", function () {
                const arquivo = this.files && this.files[0];
                const salvar = botaoSalvar();
                imagemPronta = null;
                if (salvar) { salvar.disabled = true; }
                if (!arquivo) { return; }
            
                if (["image/jpeg", "image/png"].indexOf(arquivo.type) < 0) {
                  aviso("Escolha uma imagem em JPG ou PNG.", true);
                  return;
                }
                if (arquivo.size > c_max_bytes) {
                  aviso("A imagem precisa ter até 5 MB.", true);
                  return;
                }
            
                aviso("Preparando a imagem...");
                converter(arquivo).then(function (blob) {
                  imagemPronta = blob;
                  mostrarPrevia(blob);
                  if (botaoSalvar()) { botaoSalvar().disabled = false; }
                  aviso("Confira a prévia e clique em Salvar foto.");
                }).catch(function () {
                  aviso("Não foi possível ler essa imagem. Tente outra, em JPG ou PNG.", true);
                });
              });
            
              $(document).on("click", "[data-acao='salvar-foto']", function () {
                const salvar = this;
                if (!imagemPronta) { return; }
                salvar.disabled = true;
                aviso("Salvando...");
            
                paraBase64(imagemPronta).then(function (base64) {
                  const partes = apex.server.chunk(base64);
                  return apex.server.process("SALVAR_FOTO",
                    { f01: Array.isArray(partes) ? partes : [partes] },
                    { dataType: "json" });
                }).then(function (resposta) {
                  if (resposta.ok) {
                    aviso(resposta.mensagem);
                    location.reload();
                  } else {
                    aviso(resposta.mensagem, true);
                    salvar.disabled = false;
                  }
                }, function () {
                  aviso("Não foi possível falar com o servidor. Confira sua conexão e tente de novo.", true);
                  salvar.disabled = false;
                });
              });
            })();
            
            ```
    }
    css {
        fileUrls: #APP_FILES#Meu Perfil#MIN#.css
    }
    security {
        authorizationScheme: @colaborador
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cabeçalho-do-perfil (
        name: Cabeçalho do perfil
        type: dynamicContent
        source {
            plsqlFunctionBody: return pkg_perfil.render_cabecalho(to_number(:P2_ID_COLABORADOR default null on conversion error));
            pageItemsToSubmit: P2_ID_COLABORADOR
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region perfil-do-colaborador (
        name: Perfil do Colaborador
        type: dynamicContent
        source {
            plsqlFunctionBody: return pkg_perfil.render(to_number(:P2_ID_COLABORADOR default null on conversion error));
            pageItemsToSubmit: P2_ID_COLABORADOR
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P2_ID_COLABORADOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            slot: body
        }
        sessionState {
            storage: request
        }
    )

    process perfil-drawer-foto (
        name: PERFIL_DRAWER_FOTO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_util.prn(
                  p_clob   => pkg_perfil.render_drawer_foto(
                                to_number(apex_application.g_x01 default null on conversion error)),
                  p_escape => false);
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 39812565727690203
        }
    )

    process salvar-foto (
        name: SALVAR_FOTO
        type: executeCode
        source {
            plsqlCode: pkg_foto_perfil.ajax_salvar;
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 49540197464914802
        }
    )

)

