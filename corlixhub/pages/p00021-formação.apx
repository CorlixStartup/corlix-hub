page 21 (
    name: Formação
    alias: FORMAÇÃO
    title: Formação
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @admin-rh
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formação (
        name: Formação
        type: form
        source {
            location: localDatabase
            tableName: FORMACAO_COLABORADOR
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P21_BL_ANEXO (
        type: fileUpload
        label {
            label: Anexo (PDF ou imagem)
            alignment: left
        }
        display {
            downloadLinkText: Baixar anexo
        }
        storage {
            mimeTypeColumn: DS_MIME_TYPE
            filenameColumn: DS_NOME_ARQUIVO
            fileTypes: .pdf,image/*
            maxFileSize: 5120
        }
        layout {
            sequence: 130
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @formação
            column: BL_ANEXO
            dataType: blob
        }
    )

    pageItem P21_DS_INSTITUICAO (
        type: textField
        label {
            label: Instituição
            alignment: left
        }
        layout {
            sequence: 70
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @formação
            column: DS_INSTITUICAO
            dataType: varchar2
        }
    )

    pageItem P21_DS_LINK (
        type: textField
        label {
            label: Link (https://...)
            alignment: left
        }
        layout {
            sequence: 120
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @formação
            column: DS_LINK
            dataType: varchar2
        }
    )

    pageItem P21_DS_TITULO (
        type: textField
        label {
            label: Título
            alignment: left
        }
        layout {
            sequence: 50
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 300
        }
        source {
            formRegion: @formação
            column: DS_TITULO
            dataType: varchar2
        }
    )

    pageItem P21_DT_CONCLUSAO (
        type: datePicker
        label {
            label: Conclusão
            alignment: left
        }
        layout {
            sequence: 90
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @formação
            column: DT_CONCLUSAO
            dataType: date
        }
    )

    pageItem P21_DT_INICIO (
        type: datePicker
        label {
            label: Início
            alignment: left
        }
        layout {
            sequence: 80
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @formação
            column: DT_INICIO
            dataType: date
        }
    )

    pageItem P21_DT_VALIDADE (
        type: datePicker
        label {
            label: Validade
            alignment: left
        }
        layout {
            sequence: 100
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @formação
            column: DT_VALIDADE
            dataType: date
        }
    )

    pageItem P21_ID_COLABORADOR (
        type: hidden
        layout {
            sequence: 30
            region: @formação
            slot: regionBody
        }
        source {
            formRegion: @formação
            column: ID_COLABORADOR
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P21_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @formação
            slot: regionBody
        }
        source {
            formRegion: @formação
            column: ID_EMPRESA
            dataType: number
        }
    )

    pageItem P21_ID_FORMACAO (
        type: hidden
        layout {
            sequence: 10
            region: @formação
            slot: regionBody
        }
        source {
            formRegion: @formação
            column: ID_FORMACAO
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P21_NR_CARGA_HORARIA (
        type: numberField
        label {
            label: Carga horária (h)
            alignment: left
        }
        layout {
            sequence: 110
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @formação
            column: NR_CARGA_HORARIA
            dataType: number
        }
    )

    pageItem P21_TP_FORMACAO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-tipo-formacao
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 40
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formação
            column: TP_FORMACAO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        security {
            authorizationScheme: @admin-rh
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P21_ID_FORMACAO
        }
        security {
            authorizationScheme: @admin-rh
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_ID_FORMACAO
        }
        security {
            authorizationScheme: @admin-rh
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_ID_FORMACAO
        }
        security {
            authorizationScheme: @admin-rh
        }
    )

    validation carga-horária (
        name: Carga horária
        execution {
            sequence: 50
        }
        validation {
            plsqlExpression: :P21_NR_CARGA_HORARIA is null or to_number(:P21_NR_CARGA_HORARIA) > 0
        }
        error {
            errorMessage: A carga horária deve ser maior que zero.
            associatedItem: @P21_NR_CARGA_HORARIA
        }
    )

    validation conclusão-depois-do-início (
        name: Conclusão depois do início
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression: :P21_DT_CONCLUSAO is null or :P21_DT_INICIO is null or to_date(:P21_DT_CONCLUSAO, 'DD/MM/YYYY') >= to_date(:P21_DT_INICIO, 'DD/MM/YYYY')
        }
        error {
            errorMessage: A conclusão não pode ser antes do início.
            associatedItem: @P21_DT_CONCLUSAO
        }
    )

    validation data-obrigatória (
        name: Data obrigatória
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :P21_DT_INICIO is not null or :P21_DT_CONCLUSAO is not null
        }
        error {
            errorMessage: Informe a data de início ou de conclusão.
            associatedItem: @P21_DT_INICIO
        }
    )

    validation formação-da-empresa (
        name: Formação da empresa
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                  l_qt pls_integer;
                begin
                  if :P21_ID_FORMACAO is not null then
                    select count(*) into l_qt
                      from formacao_colaborador
                     where id_formacao = :P21_ID_FORMACAO
                       and id_empresa  = :G_ID_EMPRESA;
                  else
                    select count(*) into l_qt
                      from colaborador
                     where id_colaborador = :P21_ID_COLABORADOR
                       and id_empresa     = :G_ID_EMPRESA;
                  end if;
                  return l_qt = 1;
                end;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Formação não encontrada.
        }
    )

    validation link (
        name: Link
        execution {
            sequence: 60
        }
        validation {
            plsqlExpression: :P21_DS_LINK is null or regexp_like(:P21_DS_LINK, '^https?://', 'i')
        }
        error {
            errorMessage: O link deve começar com http:// ou https://.
            associatedItem: @P21_DS_LINK
        }
    )

    validation validade (
        name: Validade
        execution {
            sequence: 40
        }
        validation {
            plsqlExpression: :P21_DT_VALIDADE is null or to_date(:P21_DT_VALIDADE, 'DD/MM/YYYY') >= to_date(coalesce(:P21_DT_CONCLUSAO, :P21_DT_INICIO), 'DD/MM/YYYY')
        }
        error {
            errorMessage: A validade não pode ser antes da conclusão.
            associatedItem: @P21_DT_VALIDADE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 33885343087136618
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process empresa-da-sessão (
        name: Empresa da sessão
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P21_ID_EMPRESA := :G_ID_EMPRESA;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 33898273578350914
        }
    )

    process initialize-form-formação (
        name: Initialize form Formação
        type: formInitialization
        formRegion: @formação
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 33884590914136616
        }
    )

    process process-form-formação (
        name: Process form Formação
        type: formAutoRowProcessing
        formRegion: @formação
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 33884964000136617
        }
    )

)

