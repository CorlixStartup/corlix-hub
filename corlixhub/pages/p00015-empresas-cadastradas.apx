page 15 (
    name: Empresas Cadastradas
    alias: EMPRESAS-CADASTRADAS
    title: Empresas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cabeçalho (
        name: Cabeçalho
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                return '<div class="cx-cabecalho-pagina cx-cabecalho-pagina--acoes">'
                    || '<div class="cx-cabecalho-pagina__texto">'
                    || '<h1 class="cx-cabecalho-pagina__titulo">Empresas</h1>'
                    || '<p class="cx-cabecalho-pagina__descricao">Consulte e mantenha as empresas cadastradas no CorlixHub.</p>'
                    || '</div>'
                    || '<div class="cx-cabecalho-pagina__acoes">'
                    || '<a class="t-Button t-Button--hot t-Button--iconLeft" href="'
                    || apex_escape.html_attribute(apex_page.get_url(p_page => 16, p_clear_cache => '16'))
                    || '"><span class="t-Icon t-Icon--left fa fa-plus" aria-hidden="true"></span>'
                    || '<span class="t-Button-label">Nova empresa</span></a>'
                    || '</div>'
                    || '</div>';
                
                ```
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
    )

    region empresas-cadastradas (
        name: Empresas Cadastradas
        title: Empresas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.id_empresa,
                       e.nome_fantasia,
                       e.nome,
                       e.cnpj,
                       e.cidade || case when e.uf is not null then ' – ' || e.uf end as cidade_uf,
                       e.email_corporativo,
                       case when regexp_like(e.telefone, '^\d{11}$') then regexp_replace(e.telefone, '^(\d{2})(\d{5})(\d{4})$', '(\1) \2-\3')
                     when regexp_like(e.telefone, '^\d{10}$') then regexp_replace(e.telefone, '^(\d{2})(\d{4})(\d{4})$', '(\1) \2-\3')
                     else e.telefone end as telefone,
                       case when e.status then 'Ativa' else 'Inativa' end as situacao,
                       case when e.status then 'sucesso' else 'neutro' end as situacao_classe,
                       e.cep,
                       e.logradouro,
                       e.numero,
                       e.complemento,
                       e.bairro,
                       e.data_criacao
                  from empresa e
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: cx-relatorio
        }
        headerAndFooter {
            footerText: <p class="cx-relatorio__nota">Endereço completo, CEP e data de abertura: Ações › Colunas</p>
        }
        link {
            linkColumn: customTarget
            target: {
                page: 16
                items: {
                    P16_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-pencil" title="Editar"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: Nenhuma empresa cadastrada.
            whenMoreDataFound: A lista passou de #MAX_ROW_COUNT# linhas. Use a pesquisa para filtrar.
        }
        advanced {
            savedReportMappingIdentifier: 9983244636177663
        }

        column BAIRRO (
            type: plainText
            heading {
                heading: Bairro
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column CEP (
            type: plainText
            heading {
                heading: CEP
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column CIDADE_UF (
            type: plainText
            heading {
                heading: Cidade/UF
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column CNPJ (
            type: plainText
            heading {
                heading: CNPJ
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COMPLEMENTO (
            type: plainText
            heading {
                heading: Complemento
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DATA_CRIACAO (
            type: plainText
            heading {
                heading: Data de abertura
            }
            layout {
                sequence: 160
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column EMAIL_CORPORATIVO (
            type: plainText
            heading {
                heading: E-mail corporativo
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column LOGRADOURO (
            type: plainText
            heading {
                heading: Logradouro
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Razão social
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOME_FANTASIA (
            type: link
            heading {
                heading: Nome fantasia
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 16
                    items: {
                        P16_ID_EMPRESA: #ID_EMPRESA#
                    }
                    clearCache: 16
                }
                linkText: #NOME_FANTASIA#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column NUMERO (
            type: plainText
            heading {
                heading: Número
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 70
            }
            columnFormatting {
                htmlExpression: <span class="cx-badge cx-badge--#SITUACAO_CLASSE#">#SITUACAO#</span>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column SITUACAO_CLASSE (
            type: hidden
            heading {
                heading: Situação classe
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Empresas
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CIDADE_UF (
                sequence: 4
            )

            displayColumn CNPJ (
                sequence: 3
            )

            displayColumn EMAIL_CORPORATIVO (
                sequence: 5
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn NOME_FANTASIA (
                sequence: 1
            )

            displayColumn SITUACAO (
                sequence: 7
            )

            displayColumn TELEFONE (
                sequence: 6
            )

            sort (
                column: NOME_FANTASIA
                sort {
                    sequence: 1
                }
            )

        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @empresas-cadastradas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

