page 23 (
    name: Responder solicitação
    alias: RESPONDER-SOLICITACAO
    title: Responder solicitação
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @admin-rh
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botões (
        name: Botões
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region solicitação (
        name: Solicitação
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P23_DS_LANCAMENTO (
        type: displayOnly
        label {
            label: Registro questionado
            alignment: left
        }
        layout {
            sequence: 30
            region: @solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P23_DS_MENSAGEM (
        type: displayOnly
        label {
            label: Pedido
            alignment: left
        }
        layout {
            sequence: 40
            region: @solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P23_DS_RESPOSTA (
        type: textarea
        label {
            label: Mensagem ao colaborador
            alignment: left
        }
        layout {
            sequence: 60
            region: @solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 2000
        }
        help {
            inlineHelpText: Obrigatória se recusar.
            helpText: Obrigatória se recusar.
        }
    )

    pageItem P23_ID_SOLICITACAO (
        type: hidden
        layout {
            sequence: 10
            region: @solicitação
            slot: regionBody
        }
    )

    pageItem P23_NM_COLABORADOR (
        type: displayOnly
        label {
            label: Colaborador
            alignment: left
        }
        layout {
            sequence: 20
            region: @solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P23_ST_SOLICITACAO (
        type: radioGroup
        label {
            label: Resposta
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Resolvida;RESOLVIDA,Recusada;RECUSADA
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    button cancelar_1 (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botões
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button responder (
        buttonName: RESPONDER
        label: Responder
        layout {
            sequence: 10
            region: @botões
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction click (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar_1
        }

        action click (
            name: Cancelar
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process carregar-solicitação (
        name: Carregar solicitação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  select c.nome_completo,
                         s.ds_mensagem,
                         case when h.id_historico_carreira is not null
                              then to_char(h.dt_efetiva, 'dd/mm/yyyy') || ' · ' || t.ds_tipo
                              else 'Não informado'
                         end
                    into :P23_NM_COLABORADOR, :P23_DS_MENSAGEM, :P23_DS_LANCAMENTO
                    from solicitacao_correcao s
                    join colaborador c             on c.id_colaborador        = s.id_colaborador
                    left join historico_carreira h on h.id_historico_carreira = s.id_historico_carreira
                    left join tipo_movimentacao  t on t.id_tipo_movimentacao  = h.id_tipo_movimentacao
                   where s.id_solicitacao = :P23_ID_SOLICITACAO
                     and s.id_empresa     = :G_ID_EMPRESA
                     and s.st_solicitacao = 'ABERTA';
                exception
                  when no_data_found then
                    raise_application_error(-20019, 'Solicitação não encontrada ou já respondida.');
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 38218898827837932
        }
    )

    process fechar (
        name: Fechar
        type: closeDialog
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Resposta registrada.
        }
        advanced {
            executionMappingIdentifier: 38219622505837940
        }
        serverSideCondition {
            whenButtonPressed: @responder
        }
    )

    process responder (
        name: Responder
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_historico_carreira.responder_solicitacao(
                  p_id_solicitacao => :P23_ID_SOLICITACAO,
                  p_st_solicitacao => :P23_ST_SOLICITACAO,
                  p_ds_resposta    => :P23_DS_RESPOSTA);
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 38219540875837939
        }
        serverSideCondition {
            whenButtonPressed: @responder
        }
    )

)

