page 43 (
    name: Artigo
    alias: ARTIGO
    title: Artigo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @suporte-ti
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region artigo (
        name: Artigo
        type: form
        source {
            location: localDatabase
            tableName: SUPORTE_ARTIGO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P43_DH_ATUALIZACAO (
        type: datePicker
        label {
            label: Dh Atualizacao
            alignment: right
        }
        layout {
            sequence: 110
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @artigo
            column: DH_ATUALIZACAO
            dataType: timestampWithTimeZone
        }
    )

    pageItem P43_DS_CORPO (
        type: textarea
        label {
            label: Ds Corpo
            alignment: right
        }
        layout {
            sequence: 60
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            formRegion: @artigo
            column: DS_CORPO
            dataType: varchar2
        }
    )

    pageItem P43_DS_PALAVRAS (
        type: textarea
        label {
            label: Ds Palavras
            alignment: right
        }
        layout {
            sequence: 70
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @artigo
            column: DS_PALAVRAS
            dataType: varchar2
        }
    )

    pageItem P43_DS_RESUMO (
        type: textarea
        label {
            label: Ds Resumo
            alignment: right
        }
        layout {
            sequence: 50
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 300
        }
        source {
            formRegion: @artigo
            column: DS_RESUMO
            dataType: varchar2
        }
    )

    pageItem P43_DS_TITULO (
        type: textField
        label {
            label: Ds Titulo
            alignment: right
        }
        layout {
            sequence: 40
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
        source {
            formRegion: @artigo
            column: DS_TITULO
            dataType: varchar2
        }
    )

    pageItem P43_FL_PUBLICADO (
        type: textField
        label {
            label: Fl Publicado
            alignment: right
        }
        layout {
            sequence: 100
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 1
        }
        source {
            formRegion: @artigo
            column: FL_PUBLICADO
            dataType: varchar2
        }
    )

    pageItem P43_ID_ARTIGO (
        type: hidden
        layout {
            sequence: 10
            region: @artigo
            slot: regionBody
        }
        source {
            formRegion: @artigo
            column: ID_ARTIGO
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P43_ID_ASSUNTO (
        type: selectList
        label {
            label: Id Assunto
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @suporte-assunto-nm-assunto
        }
        layout {
            sequence: 30
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @artigo
            column: ID_ASSUNTO
            dataType: number
        }
    )

    pageItem P43_ID_EMPRESA (
        type: selectList
        label {
            label: Id Empresa
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @empresa-nome
        }
        layout {
            sequence: 20
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @artigo
            column: ID_EMPRESA
            dataType: number
        }
    )

    pageItem P43_NR_ACESSOS (
        type: numberField
        label {
            label: Nr Acessos
            alignment: right
        }
        layout {
            sequence: 90
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @artigo
            column: NR_ACESSOS
            dataType: number
        }
    )

    pageItem P43_NR_MIN_LEITURA (
        type: numberField
        label {
            label: Nr Min Leitura
            alignment: right
        }
        layout {
            sequence: 80
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @artigo
            column: NR_MIN_LEITURA
            dataType: number
        }
    )

    pageItem P43_USR_ATUALIZACAO (
        type: textField
        label {
            label: Usr Atualizacao
            alignment: right
        }
        layout {
            sequence: 120
            region: @artigo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @artigo
            column: USR_ATUALIZACAO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P43_ID_ARTIGO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P43_ID_ARTIGO
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P43_ID_ARTIGO
        }
    )

    validation p43-dh-atualizacao-must-be-timestamp (
        name: P43_DH_ATUALIZACAO must be timestamp
        execution {
            sequence: 100
        }
        validation {
            type: itemIsAValidTimestamp
            item: P43_DH_ATUALIZACAO
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P43_DH_ATUALIZACAO
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 47666478597854346
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-artigo (
        name: Initialize form Artigo
        type: formInitialization
        formRegion: @artigo
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 47665653040854344
        }
    )

    process process-form-artigo (
        name: Process form Artigo
        type: formAutoRowProcessing
        formRegion: @artigo
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 47666039421854345
        }
    )

)

