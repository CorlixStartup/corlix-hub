page 17 (
    name: Novo comunicado
    alias: COMUNICADO
    title: Novo comunicado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 680
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#modulos/comunicados/comunicado#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region aviso (
        name: Aviso
        type: staticContent
        source {
            htmlCode: <p class="cx-comunicado__aviso">Campos marcados com * são obrigatórios.</p>
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: cx-comunicado
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region step-1 (
        name: Emitir comunicado
        title: Novo comunicado
        type: form
        source {
            location: localDatabase
            tableName: COMUNICADO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: cx-comunicado
        }
    )

    pageItem P17_CONTEUDO (
        type: textarea
        label {
            label: Comunicado
            alignment: left
        }
        layout {
            sequence: 40
            region: @step-1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 6
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @step-1
            column: CONTEUDO
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P17_DATA_PUBLICACAO (
        type: hidden
        layout {
            sequence: 50
            region: @step-1
            slot: regionBody
        }
        source {
            formRegion: @step-1
            column: DATA_PUBLICACAO
            dataType: date
        }
        default {
            type: expression
            plsqlExpression: cast(systimestamp at time zone 'America/Sao_Paulo' as date)
        }
    )

    pageItem P17_FL_FIXADO (
        type: checkbox
        label {
            label: Fixar no topo
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 70
            region: @step-1
            slot: regionBody
            alignment: left
            columnCssClasses: cx-comunicado__fixar
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @step-1
            column: FL_FIXADO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
        help {
            inlineHelpText: Aparece primeiro na lista de comunicados.
        }
    )

    pageItem P17_ID_AUTOR (
        type: hidden
        layout {
            sequence: 10
            region: @step-1
            slot: regionBody
        }
        source {
            formRegion: @step-1
            column: ID_AUTOR
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select id_colaborador from colaborador
                 where upper(trim(login_apex)) = upper(trim(:APP_USER))
                   and id_empresa = :G_ID_EMPRESA
                ```
        }
    )

    pageItem P17_ID_CATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-categoria-comunicado
        }
        layout {
            sequence: 20
            region: @step-1
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @step-1
            column: ID_CATEGORIA
            dataType: number
        }
        help {
            inlineHelpText: Tipo do comunicado (ex.: Eventos).
        }
    )

    pageItem P17_ID_COMUNICADO (
        type: hidden
        layout {
            sequence: 10
            region: @step-1
            slot: regionBody
        }
        source {
            formRegion: @step-1
            column: ID_COMUNICADO
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P17_ID_DEPARTAMENTO (
        type: selectList
        label {
            label: Departamento destinatário
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-departamento-empresa
        }
        layout {
            sequence: 10
            region: @step-1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @step-1
            column: ID_DEPARTAMENTO
            dataType: number
        }
        help {
            inlineHelpText: Só esse departamento verá o comunicado.
        }
    )

    pageItem P17_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 10
            region: @step-1
            slot: regionBody
        }
        source {
            formRegion: @step-1
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: item
            item: G_ID_EMPRESA
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P17_IMAGEM (
        type: imageUpload
        label {
            label: Imagem (opcional)
            alignment: left
        }
        display {
            displayAs: inlineDropzone
            dropzoneTitle: Arraste uma imagem ou clique para selecionar
            dropzoneDesc: PNG ou JPG · você poderá recortar em 16:9 após selecionar
        }
        storage {
            mimeTypeColumn: MIME_TYPE
            filenameColumn: NOME_ARQUIVO
        }
        cropping {
            allowCropping: true
            aspectRatio: widescreen
        }
        resizeTo {
            maxFileSize: 5120
        }
        layout {
            sequence: 60
            region: @step-1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @step-1
            column: IMAGEM
            dataType: blob
        }
    )

    pageItem P17_MIME_TYPE (
        type: hidden
        layout {
            sequence: 70
            region: @step-1
            slot: regionBody
        }
        source {
            formRegion: @step-1
            column: MIME_TYPE
            dataType: varchar2
        }
    )

    pageItem P17_NOME_ARQUIVO (
        type: hidden
        layout {
            sequence: 80
            region: @step-1
            slot: regionBody
        }
        source {
            formRegion: @step-1
            column: NOME_ARQUIVO
            dataType: varchar2
        }
    )

    pageItem P17_PUBLICO (
        type: radioGroup
        label {
            label: Público
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Todos;TODOS,Um departamento;DEPARTAMENTO
            displayNullValue: false
        }
        layout {
            sequence: 8
            region: @step-1
            slot: regionBody
            alignment: left
            columnCssClasses: cx-comunicado__publico
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: TODOS
        }
    )

    pageItem P17_TITULO (
        type: textField
        label {
            label: Título
            alignment: left
        }
        layout {
            sequence: 30
            region: @step-1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @step-1
            column: TITULO
            dataType: varchar2
        }
        help {
            inlineHelpText: Frase curta e objetiva. Evite escrever tudo em maiúsculas.
        }
    )

    button cancel (
        buttonName: cancelar
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button next (
        buttonName: PUBLICAR_COMUNICADO
        label: Publicar comunicado
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            showProcessing: true
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    dynamicAction público (
        name: Público
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P17_PUBLICO
        }
        clientSideCondition {
            type: item=value
            item: P17_PUBLICO
            value: DEPARTAMENTO
        }

        action false (
            name: False
            action: hide
            affectedElements {
                selectionType: items
                items: P17_ID_DEPARTAMENTO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action true (
            name: True
            action: show
            affectedElements {
                selectionType: items
                items: P17_ID_DEPARTAMENTO
            }
            execution {
                sequence: 10
            }
        )

    )

    validation departamento-obrigatório (
        name: Departamento obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P17_ID_DEPARTAMENTO
        }
        error {
            errorMessage: Escolha o departamento destinatário.
            associatedItem: @P17_ID_DEPARTAMENTO
        }
        serverSideCondition {
            type: item=value
            item: P17_PUBLICO
            value: DEPARTAMENTO
        }
    )

    validation imagem-png-ou-jpg (
        name: Imagem PNG ou JPG
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: regexp_like(:P17_IMAGEM, '\.(png|jpe?g)$', 'i');
        }
        error {
            errorMessage: Envie uma imagem PNG ou JPG.
            associatedItem: @P17_IMAGEM
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P17_IMAGEM
        }
    )

    computation p17-id-departamento (
        itemName: P17_ID_DEPARTAMENTO
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: staticValue
        }
        serverSideCondition {
            type: item=value
            item: P17_PUBLICO
            value: TODOS
        }
    )

    process fechar (
        name: Fechar
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 47615342302452043
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    process initialize-form-emitir-comunicado (
        name: Initialize form Emitir Comunicado
        type: formInitialization
        formRegion: @step-1
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9265647718807338
        }
    )

    process processo-emissao-comunicado (
        name: processo-emissao-comunicado
        type: formAutoRowProcessing
        formRegion: @step-1
        target {
            targetType: tableView
            tableName: COMUNICADO
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Comunicado publicado.
        }
        error {
            errorMessage: Não foi possível emitir o comunicado, tente novamente.
        }
        advanced {
            executionMappingIdentifier: 10214262639327047
        }
    )

)

