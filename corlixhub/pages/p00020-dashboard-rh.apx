    pageItem P20_DT_FIM (
        type: datePicker
        label {
            label: Até
            alignment: left
        }
        settings {
            minDate: item
            minItem: P20_DT_INICIO
        }
        layout {
            sequence: 20
            region: @período
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 30
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(pkg_historico_carreira.fn_hoje(:G_ID_EMPRESA), 'DD/MM/YYYY')
        }
    )

    pageItem P20_DT_INICIO (
        type: datePicker
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @período
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 30
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression:
                ```plsql
                to_char(add_months(trunc(pkg_historico_carreira.fn_hoje(:G_ID_EMPRESA), 'mm'), -11), 'DD/MM/YYYY')
                
                ```
        }
    )

    dynamicAction atualizar-solicitações (
        name: Atualizar solicitações
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @rel_solicitacoes
        }

        action true (
            name: Atualizar lista
            action: refresh
            affectedElements {
                selectionType: region
                region: @rel_solicitacoes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction período-mudou (
        name: Período mudou
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P20_DT_INICIO
                P20_DT_FIM
            ]
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P20_DT_INICIO') !== '' && $v('P20_DT_FIM') !== ''
        }

        action período-mudou-verdadeiro (
            name: Atualizar promoções
            action: refresh
            affectedElements {
                selectionType: region
                region: @grafico_promocoes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action true (
            name: Atualizar turnover
            action: refresh
            affectedElements {
                selectionType: region
                region: @grafico_turnover
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

