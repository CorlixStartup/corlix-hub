                heading: Data do registro
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID_COLABORADOR (
