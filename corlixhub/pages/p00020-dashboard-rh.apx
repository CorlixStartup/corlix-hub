page 20 (
    name: Dashboard RH
    alias: DASHBOARD-RH
    title: Dashboard RH
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#historico-carreira#MIN#.css
    }
    security {
        authorizationScheme: @admin-rh
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cabeçalho (
        name: Cabeçalho
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hc" data-hc>
                  <header class="hc-titulo">
                    <div>
                      <h1>Dashboard RH</h1>
                      <p>Promoções, turnover, tempo no cargo e formações a vencer no período escolhido.</p>
                    </div>
                  </header>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
    )

    region grafico_promocoes (
        name: Promoções por departamento
        type: chart
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 360
        }
        animation {
            onDisplay: none
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: Nenhuma promoção no período.
        }

        series promoções (
            name: Promoções
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select coalesce(d.nome, '(sem departamento)') as departamento,
                           count(*)                               as promocoes
                      from vw_movimentacao_valida v
                      left join departamento d
                             on d.id_departamento = v.id_departamento_novo
                     where v.id_empresa = :G_ID_EMPRESA
                       and v.cd_tipo    = 'PROMOCAO'
                       and v.dt_efetiva between to_date(:P20_DT_INICIO, 'DD/MM/YYYY')
                                            and to_date(:P20_DT_FIM,    'DD/MM/YYYY')
                     group by d.id_departamento, d.nome
                     order by promocoes desc, departamento
                    
                    ```
                pageItemsToSubmit: [
                    P20_DT_INICIO
                    P20_DT_FIM
                ]
            }
            columnMapping {
                label: DEPARTAMENTO
                value: PROMOCOES
            }
            appearance {
                color: #00688c
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
            title: Promoções
            value {
                min: 0
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            majorTicks {
                minStep: 1
            }
            minorTicks {
                show: false
            }
        )

    )

    region grafico_tempo_cargo (
        name: Tempo médio no cargo por departamento
        type: chart
        layout {
            sequence: 35
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 360
        }
        animation {
            onDisplay: none
        }
        legend {
            show: false
        }

        series new (
            name: Anos no cargo
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(s.nm_departamento, '(sem departamento)') as departamento,
                           round(avg(months_between(pkg_historico_carreira.fn_hoje(:G_ID_EMPRESA),
                                                    s.dt_inicio_funcao)) / 12, 1) as anos_no_cargo
                      from vw_situacao_atual_colaborador s
                     where s.id_empresa       = :G_ID_EMPRESA
                       and s.fl_vinculo_ativo = 'S'
                     group by s.id_departamento, s.nm_departamento
                     order by anos_no_cargo desc, departamento
                    ```
            }
            columnMapping {
                label: DEPARTAMENTO
                value: ANOS_NO_CARGO
            }
            appearance {
                color: #00688c
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
            title: anos
            value {
                min: 0
                format: decimal
                decimalPlaces: 1
                formatScaling: none
            }
        )

    )

    region grafico_turnover (
        name: Turnover: admissões x desligamentos por mês
        type: chart
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chartLayout {
            height: 360
        }
        animation {
            onDisplay: none
        }

        series desligamentos (
            name: Desligamentos
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    with periodo as (
                      select to_date(:P20_DT_INICIO, 'DD/MM/YYYY') as dt_inicio,
                             to_date(:P20_DT_FIM,    'DD/MM/YYYY') as dt_fim
                        from dual
                    ),
                    meses as (
                      select add_months(trunc(p.dt_inicio, 'mm'), level - 1) as mes
                        from periodo p
                     connect by level <= months_between(trunc(p.dt_fim, 'mm'), trunc(p.dt_inicio, 'mm')) + 1
                    )
                    select to_char(m.mes, 'yyyy/mm')                              as mes,
                           count(case when v.cd_tipo = 'ADMISSAO'     then 1 end) as admissoes,
                           count(case when v.cd_tipo = 'DESLIGAMENTO' then 1 end) as desligamentos
                      from meses m
                     cross join periodo p
                      left join vw_movimentacao_valida v
                             on v.id_empresa  = :G_ID_EMPRESA
                            and v.cd_tipo    in ('ADMISSAO', 'DESLIGAMENTO')
                            and v.dt_efetiva >= m.mes
                            and v.dt_efetiva <  add_months(m.mes, 1)
                            and v.dt_efetiva between p.dt_inicio and p.dt_fim
                     group by m.mes
                     order by m.mes
                    
                    ```
                pageItemsToSubmit: [
                    P20_DT_INICIO
                    P20_DT_FIM
                ]
            }
            columnMapping {
                label: MES
                value: DESLIGAMENTOS
            }
            appearance {
                color: #b3261e
            }
        )

        series new (
            name: Admissões
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    with periodo as (
                      select to_date(:P20_DT_INICIO, 'DD/MM/YYYY') as dt_inicio,
                             to_date(:P20_DT_FIM,    'DD/MM/YYYY') as dt_fim
                        from dual
                    ),
                    meses as (
                      select add_months(trunc(p.dt_inicio, 'mm'), level - 1) as mes
                        from periodo p
                     connect by level <= months_between(trunc(p.dt_fim, 'mm'), trunc(p.dt_inicio, 'mm')) + 1
                    )
                    select to_char(m.mes, 'yyyy/mm')                              as mes,
                           count(case when v.cd_tipo = 'ADMISSAO'     then 1 end) as admissoes,
                           count(case when v.cd_tipo = 'DESLIGAMENTO' then 1 end) as desligamentos
                      from meses m
                     cross join periodo p
                      left join vw_movimentacao_valida v
                             on v.id_empresa  = :G_ID_EMPRESA
                            and v.cd_tipo    in ('ADMISSAO', 'DESLIGAMENTO')
                            and v.dt_efetiva >= m.mes
                            and v.dt_efetiva <  add_months(m.mes, 1)
                            and v.dt_efetiva between p.dt_inicio and p.dt_fim
                     group by m.mes
                     order by m.mes
                    ```
                pageItemsToSubmit: [
                    P20_DT_INICIO
                    P20_DT_FIM
                ]
            }
            columnMapping {
                label: MES
                value: ADMISSOES
            }
            appearance {
                color: #00688c
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
            title: Pessoas
            value {
                min: 0
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            majorTicks {
                minStep: 1
            }
            minorTicks {
                show: false
            }
        )

    )

    region período (
        name: Período
        type: staticContent
