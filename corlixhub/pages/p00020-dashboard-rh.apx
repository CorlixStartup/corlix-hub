    region rel_formacoes_vencer (
        name: Formações a vencer
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.id_colaborador       as id_colaborador,
                       c.nome_completo        as colaborador,
                       f.ds_titulo            as formacao,
                       f.tp_formacao          as tipo,
                       f.ds_instituicao       as emissor,
                       f.dt_validade          as validade,
                       f.dt_validade - pkg_historico_carreira.fn_hoje(:G_ID_EMPRESA) as dias_restantes
                  from formacao_colaborador f
                  join colaborador c on c.id_colaborador = f.id_colaborador
                 where f.id_empresa  = :G_ID_EMPRESA
                   and f.dt_validade between pkg_historico_carreira.fn_hoje(:G_ID_EMPRESA)
                                         and pkg_historico_carreira.fn_hoje(:G_ID_EMPRESA) + 60
                 order by f.dt_validade
                
                ```
        }
        layout {
            sequence: 45
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nenhuma formação vence nos próximos 60 dias.
        }

        column COLABORADOR (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Colaborador
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 19
                    items: {
                        P19_ID_COLABORADOR: #ID_COLABORADOR#
                    }
                }
                linkText: #COLABORADOR#
            }
            sorting {
                sortable: false
            }
        )

        column DIAS_RESTANTES (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Dias restantes
                alignment: end
